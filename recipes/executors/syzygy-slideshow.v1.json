{
  "schema": "content-lab.syzygy-slideshow-executor.v1",
  "executorId": "syzygy-slideshow",
  "source": "syzygy_r2_library",
  "selection": "deterministic_variety_without_replacement",
  "reservation": "active_jobs_and_completed_outputs",
  "formats": {
    "lyric-edits": {
      "lane": "slideshow-webweaving",
      "minimumLibraryItems": 6,
      "templates": [
        {"slug": "karaoke-postcard", "mediaCount": 4},
        {"slug": "memory-slideshow", "mediaCount": 6},
        {"slug": "blue-hour", "mediaCount": 6}
      ]
    },
    "meme-slideshow": {
      "lane": "meme",
      "minimumLibraryItems": 5,
      "templates": [
        {"slug": "digital-postcard-hook", "mediaCount": 5},
        {"slug": "clean-slideshow", "mediaCount": 5},
        {"slug": "mirror-split", "mediaCount": 5}
      ]
    }
  },
  "output": {
    "container": "video/mp4",
    "aspectRatio": "9:16",
    "width": 1080,
    "height": 1920,
    "encodePreset": "tiktok_delivery_v1",
    "audioPolicy": "campaign_sound_bound_downstream"
  }
}
