@@ -0,0 +1,40 @@
+"""Offline baseline-red/candidate-green caller proof and bounded scan timings."""
+import contextlib, io, json, linecache, pathlib, statistics, subprocess, tempfile, time, types, unittest
+from unittest.mock import patch
+import publish, test_reconcile, test_publish
+
+BASELINE = '87099ac1e75450f6652b2790ca589d5f0087413f'
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+
+def main():
+    source = subprocess.check_output(['git', '-C', str(ROOT), 'show', BASELINE + ':tools/photo-library/publish.py'], text=True)
+    baseline = types.ModuleType('baseline_publish'); baseline.__file__ = publish.__file__
+    filename = '<baseline:' + BASELINE + ':publish.py>'
+    linecache.cache[filename] = (len(source), None, source.splitlines(True), filename)
+    exec(compile(source, filename, 'exec'), baseline.__dict__)
+    results = {}
+    for label, module in [('original', baseline), ('candidate', publish)]:
+        stream = io.StringIO()
+        with patch.object(test_reconcile, 'publish', module), contextlib.redirect_stdout(stream), contextlib.redirect_stderr(stream):
+            suite = unittest.defaultTestLoader.loadTestsFromName('test_bound_duplicate_recovers_without_deleting_audit', test_reconcile.ReconcileTests)
+            result = unittest.TextTestRunner(stream=stream).run(suite)
+        assert result.testsRun == 1 and not result.errors, stream.getvalue()
+        assert len(result.failures) == (1 if label == 'original' else 0), stream.getvalue()
+        results[label] = {'tests': result.testsRun, 'failures': len(result.failures), 'errors': len(result.errors), 'output': stream.getvalue()}
+    costs = []
+    for size in (1, 29, 1024):
+        with tempfile.TemporaryDirectory(dir=ROOT/'evidence', prefix='synthetic-scan-') as tmp:
+            root = pathlib.Path(tmp); e, row, batch = test_publish.PublishTests().fixture(root)
+            raw = json.dumps(batch).encode()
+            for i in range(1, size): (e/'vision'/f'batch-{i:04}.json').write_bytes(raw)
+            samples = []
+            with patch.object(publish, 'E', e):
+                for _ in range(10):
+                    start = time.perf_counter()
+                    verdicts, reviews, bindings, equivalents, records = publish.select_reviews([row])
+                    samples.append(time.perf_counter() - start)
+                    assert len(records) == size and len(verdicts) == 1
+            costs.append({'batches': size, 'file_bytes': len(raw)*size, 'runs': len(samples), 'seconds_median': statistics.median(samples), 'seconds_max': max(samples)})
+    print(json.dumps({'baseline': BASELINE, 'caller_proof': results, 'scan_cost': costs, 'bounds': {'batches': publish.MAX_REVIEW_BATCHES, 'per_batch_bytes': publish.MAX_REVIEW_BATCH_BYTES, 'total_bytes': publish.MAX_REVIEW_TOTAL_BYTES}, 'external_calls': 0}, indent=2))
+
+if __name__ == '__main__': main()
