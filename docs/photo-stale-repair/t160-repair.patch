+import copy, hashlib, json, pathlib, tempfile, unittest
+from unittest.mock import patch
+import publish
+import test_publish
+from vision import PROMPT
+
+class ReconcileTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = pathlib.Path(self.tmp.name)
+        self.e, self.row, self.batch = test_publish.PublishTests().fixture(self.root)
+        for name, value in [('ROOT', self.root), ('E', self.e)]:
+            p = patch.object(publish, name, value); p.start(); self.addCleanup(p.stop)
+
+    def put(self, name, batch):
+        path = self.e / 'vision' / name
+        path.write_text(json.dumps(batch))
+        return path
+
+    def old(self):
+        batch = copy.deepcopy(self.batch)
+        batch['inputs'][0]['sha256'] = '0' * 64
+        batch['input_signature'] = hashlib.sha256(json.dumps({'inputs': batch['inputs'], 'model': 'glm-4.6v', 'prompt': PROMPT}, sort_keys=True).encode()).hexdigest()
+        return batch
+
+    def assembled(self):
+        files, counts = publish.assemble()
+        manifest = json.loads(next(b for k, b in files.items() if k.startswith('animals/') and k.endswith('.json')))
+        return counts['pen-pal3']['count'], manifest
+
+    def test_bound_duplicate_recovers_without_deleting_audit(self):
+        self.put('batch-999.json', self.batch)
+        before = {p.name: p.read_bytes() for p in (self.e / 'vision').iterdir()}
+        try: count, manifest = self.assembled()
+        except ValueError as exc: self.fail("valid bound duplicate must recover: " + str(exc))
+        self.assertEqual(count, 1)
+        self.assertEqual(before, {p.name: p.read_bytes() for p in (self.e / 'vision').iterdir()})
+        self.assertEqual(manifest['objects'][0]['vision']['review_sha256'], hashlib.sha256(before['batch-000.json']).hexdigest())
+        self.assertEqual({r['file']: r['sha256'] for r in manifest['review_batches']}, {n: hashlib.sha256(b).hexdigest() for n, b in before.items()})
+
+    def test_single_current_review_still_accepts(self):
+        count, manifest = self.assembled()
+        self.assertEqual(count, 1)
+        self.assertEqual(manifest['review_batches'][0]['current_verdicts'], 1)
+        self.assertEqual(manifest['review_batches'][0]['stale_verdicts'], 0)
+
+    def test_reordered_shrunken_batch_keeps_matching_photo_only(self):
+        batch = copy.deepcopy(self.batch)
+        removed = {'id': 'pen-pal3:removed', 'sha256': 'f' * 64}
+        removed_verdict = copy.deepcopy(batch['photos'][0]); removed_verdict['id'] = removed['id']
+        batch['inputs'].insert(0, removed); batch['photos'].append(removed_verdict)
+        batch['input_signature'] = hashlib.sha256(json.dumps({'inputs': batch['inputs'], 'model': 'glm-4.6v', 'prompt': PROMPT}, sort_keys=True).encode()).hexdigest()
+        self.put('batch-999.json', batch)
+        count, manifest = self.assembled()
+        self.assertEqual(count, 1)
+        self.assertEqual(manifest['review_batches'][1]['current_verdicts'], 1)
+        self.assertEqual(manifest['review_batches'][1]['stale_verdicts'], 1)
+        self.assertEqual(len(manifest['objects'][0]['vision']['equivalent_review_sha256s']), 2)
+
+    def test_old_bytes_do_not_override_current_review(self):
+        old = self.old(); old['photos'][0]['fit_score'] = 1
+        self.put('batch-999.json', old)
+        self.assertEqual(self.assembled()[0], 1)
+
+    def test_conflicting_current_reviews_refuse_in_both_orders(self):
+        other = copy.deepcopy(self.batch); other['photos'][0]['fit_score'] = 1
+        for first, second in [(self.batch, other), (other, self.batch)]:
+            self.put('batch-000.json', first); self.put('batch-999.json', second)
+            with self.assertRaisesRegex(ValueError, 'conflicting current verdict'):
+                publish.assemble()
+            self.assertFalse((self.e / 'pen-pal3-manifest.json').exists())
+
+    def test_current_rejection_not_overridden_by_stale_pass(self):
+        current = copy.deepcopy(self.batch); current['photos'][0]['fit_score'] = 1
+        self.put('batch-000.json', current); self.put('batch-999.json', self.old())
+        self.assertEqual(self.assembled()[0], 0)
+
+    def test_only_stale_review_quarantines_candidate(self):
+        self.put('batch-000.json', self.old())
+        self.assertEqual(self.assembled()[0], 0)
+
+    def test_equivalent_verdict_different_record_keeps_all_provenance(self):
+        equivalent = copy.deepcopy(self.batch); equivalent['elapsed_seconds'] = 3
+        self.put('batch-999.json', equivalent)
+        count, manifest = self.assembled()
+        self.assertEqual(count, 1)
+        self.assertEqual(len(manifest['review_batches']), 2)
+        self.assertEqual(len(manifest['objects'][0]['vision']['equivalent_review_sha256s']), 2)
+
+    def test_recovery_does_not_override_operator_veto(self):
+        self.put('batch-999.json', self.batch)
+        (self.e / 'operator-visual-review.json').write_text(json.dumps({'exclusions': {'pen-pal3:1': 'veto'}}))
+        self.assertEqual(self.assembled()[0], 0)
+
+    def test_duplicate_inputs_and_in_batch_verdicts_refuse(self):
+        for field in ['inputs', 'photos']:
+            batch = copy.deepcopy(self.batch); batch[field] *= 2
+            batch['input_signature'] = hashlib.sha256(json.dumps({'inputs': batch['inputs'], 'model': 'glm-4.6v', 'prompt': PROMPT}, sort_keys=True).encode()).hexdigest()
+            self.put('batch-000.json', batch)
+            with self.assertRaises(ValueError): publish.assemble()
+
+    def test_scan_limits_refuse_without_evidence_changes(self):
+        original = (self.e / 'vision/batch-000.json').read_bytes()
+        for name, value in [('MAX_REVIEW_BATCHES', 0), ('MAX_REVIEW_BATCH_BYTES', 10), ('MAX_REVIEW_TOTAL_BYTES', 10)]:
+            with patch.object(publish, name, value):
+                with self.assertRaisesRegex(ValueError, 'review scan limit'): publish.assemble()
+            self.assertEqual((self.e / 'vision/batch-000.json').read_bytes(), original)
+
+if __name__ == '__main__': unittest.main()
