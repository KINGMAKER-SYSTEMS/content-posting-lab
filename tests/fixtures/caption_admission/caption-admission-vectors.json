 "schema": "control-plane.caption-admission-vectors.v1",
 "purpose": "Shared test vectors for the caption render check: every character must be a code point the Content Lab TikTokSans fonts draw (data/drawable-codepoints.json), then at least one word of 2+ [A-Za-z0-9] must remain once zero-width characters are removed. The English-language gate is NOT part of these vectors (every vector is English or language-free). The rail copies this file byte for byte.",
 "rules": {
  "null": "admitted",
  "emoji": "refused: an undrawable character that is an emoji",
  "character": "refused: an undrawable character that is not an emoji",
  "visible_word": "refused: every character is drawable but no 2+ [A-Za-z0-9] word remains",
  "_note": "`rule` names the Worker's refusal class (emoji / character / visible_word). The rail only has to match `admit`; both sides refuse exactly the same texts.",
  "canonical": "Apply normalization_order exactly: NFC, strip Cf, table check, word check. Order matters: see the NFC vectors."
 },
 "layout_whitespace_always_fine": [
  "U+0020",
  "U+0009",
  "U+000A",
  "U+000D"
 ],
