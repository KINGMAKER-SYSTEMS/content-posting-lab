# ── Required for video generation ─────────────────────────────────────
# At least one provider key is needed to generate videos.
XAI_API_KEY=              # Grok video generation
FAL_KEY=                  # FAL providers (Wan, Kling, Ovi)
LUMA_API_KEY=             # Luma Dream Machine
REPLICATE_API_TOKEN=      # Replicate providers (MiniMax, Wan, Kling)
OPENAI_API_KEY=           # Sora 2 video generation AND GPT-4.1 caption OCR

# ── Optional ──────────────────────────────────────────────────────────
POSTIZ_API_KEY=           # Postiz social media scheduling
POSTIZ_BASE_URL=          # Postiz API base URL (default: https://app.postiz.com)

# ── Notion (Master Pages + Campaigns) ─────────────────────────────────
NOTION_API_KEY=           # Notion integration token
NOTION_CAMPAIGNS_DB=      # Campaigns DB (TikTok Sound Links)
NOTION_PAGES_DB=          # Master Pages DB (account roster + Poster assignment)

# ── Telegram bot ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=       # Main bot (overrides stored config token)
SOUNDS_BOT_TOKEN=         # Optional send-only bot for sound assignments

# ── Telegram Mini App (poster client at /m) ───────────────────────────
# initData is validated against TELEGRAM_BOT_TOKEN — no extra secret needed.
MINIAPP_INITDATA_MAX_AGE=86400  # Max age (s) of initData auth_date; 0 disables
MINIAPP_AGENT_KEY=        # If set, agent endpoints require X-Agent-Key
MINIAPP_DEV_AUTH=         # Set to 1 ONLY for local dev: enables X-Dev-Poster-Id bypass

# ── Google Drive ─────────────────────────────────────────────────────
# Service account for Drive API. Use ONE of these:
GOOGLE_SERVICE_ACCOUNT_FILE=  # Local: path to JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=  # Railway: base64-encoded JSON key

# ── Cloudflare Email Routing ──────────────────────────────────────────
CF_API_TOKEN=             # CF API token with Email Routing permissions
CF_ZONE_ID=               # Zone ID for your email domain
CF_ACCOUNT_ID=            # Cloudflare account ID
CF_EMAIL_DOMAIN=          # Domain for email aliases (e.g. yourdomain.com)

# ── yt-dlp cookies (TikTok / YouTube downloads) ──────────────────────
# Most TikTok/YouTube URLs now require cookies. Three ways to provide them
# (first match wins; uploaded cookies.txt via /api/clipper/cookies is preferred):
#
#   1. POST a Netscape cookies.txt to /api/clipper/cookies — persisted on
#      the Railway volume, survives deploys, no redeploy needed.
#   2. YTDLP_COOKIES_FILE — absolute path to a cookies.txt inside the container.
#   3. YTDLP_COOKIES — base64-encoded cookies.txt:  `base64 -i cookies.txt`
#
# Export cookies from your browser with the "Get cookies.txt LOCALLY" extension
# while logged in to the site. See yt-dlp FAQ for details.
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES=

# ── Railway deployment ────────────────────────────────────────────────
# PORT is set automatically by Railway. Locally defaults to 8000.
# PORT=8000

# ── CORS (optional, comma-separated origins) ─────────────────────────
# Only needed if frontend is served from a different domain.
# CORS_ORIGINS=https://your-app.railway.app
